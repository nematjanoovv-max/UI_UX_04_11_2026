# Telegram Bot Token (Telegram @BotFather dan olingan token)
BOT_TOKEN=your_telegram_bot_token_here

# Bosh Admin Telegram ID (xabarnomalar uchun)
ADMIN_TELEGRAM_ID=your_telegram_id_here

# Server porti
PORT=4000

# Frontend URL (Vercel yoki boshqa domen)
