{
  "version": 2,
  "installCommand": "npm install && npm install --prefix frontend",
  "buildCommand": "cd frontend && node ./node_modules/vite/bin/vite.js build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
